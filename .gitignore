# ---- 编辑器 / 工作笔记（不入库）----
.obsidian/
agent/

# ---- 编译产物：CodeBlocks 工程（任意工程名 / 任意 board）----
**/obj/
*.depend
*.layout

# ---- 编译产物：Makefile 工程（make ac6xxn_xxx，构建目录 objs/）----
apps/spp_and_le/board/*/objs/

# ---- 编译产物：JieLi SDK（cpu/<chip>/tools，注意不要用 *.bin 通配，
#      bd19loader.bin / cfg_tool.bin / p11_code.bin / rom.lst 是厂商自带文件）----
cpu/*/tools/sdk.elf*
cpu/*/tools/sdk.lst
cpu/*/tools/sdk.map
cpu/*/tools/symbol_tbl.txt
cpu/*/tools/app.bin
cpu/*/tools/data_code.bin
cpu/*/tools/ota.bin
cpu/*/tools/ota_debug.bin
cpu/*/tools/ex_mcu*.bin
cpu/*/tools/text.bin
cpu/*/tools/data.bin
cpu/*/tools/common.bin
cpu/*/tools/bank*.bin
cpu/*/tools/aec.bin
cpu/*/tools/aac.bin
cpu/*/tools/aptx.bin
cpu/*/tools/jl_isd.ufw
cpu/*/tools/download/data_trans/app.bin
cpu/*/tools/download/data_trans/jl_isd.bin
cpu/*/tools/download/data_trans/jl_isd.fw
cpu/*/tools/download/data_trans/update.ufw
cpu/*/sdk_used_list.used-*